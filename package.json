{
  "name": "briefly-ai",
  "private": true,
  "version": "2.0.0",
  "description": "AI-powered lecture transcriber that instantly turns speech & YouTube videos into study notes, flashcards, quizzes, and mind maps using Google Gemini.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "backend": "python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8000",
    "test:backend": "python -m pytest backend/tests -q"
  },
  "dependencies": {
    "@google/genai": "^1.31.0",
    "dompurify": "^3.4.17",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "12.0.0",
    "mermaid": "10",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "overrides": {
    "katex": "^0.18.2"
  }
}
