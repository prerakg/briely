# Server-only configuration. Never prefix private keys with VITE_.
APP_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///./briefly.db

GROQ_API_KEY=
GEMINI_API_KEY=
# Optional and disabled until BOTH key/model are configured and selected.
XAI_API_KEY=
XAI_MODEL=
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional JSON: {"verification":{"groq":"openai/gpt-oss-120b"}}
AI_TASK_MODELS={}
AI_TIMEOUT=45
AI_MAX_PROMPT_CHARS=60000
AI_MAX_OUTPUT_TOKENS=6000
AI_EVIDENCE_CHARS=7000
AI_RATE_LIMIT_WAIT_SECONDS=60
AI_CACHE_SECONDS=300
REQUEST_LIMIT_PER_MINUTE=120

# Configure BOTH to enable real accounts; required in production.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role credentials are not required by this implementation.
# SUPABASE_SERVICE_ROLE_KEY must never be exposed to browsers.

# Existing multilingual YouTube subtitle provider, now server-side.
RAPID_API_KEY=
RAPID_API_HOST=
